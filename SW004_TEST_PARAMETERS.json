{
  "schema_version": 1,
  "registry_revision": "2026-10-28",
  "project": "SW-004",
  "scope": "offline simulator plus separately labeled T4 compute and future measured serving lanes",
  "evidence_classes": ["simulated", "t4_local_compute", "measured_serving", "buyer_contract", "independent_review"],
  "sources": {
    "mlperf_rules": "https://github.com/mlcommons/inference_policies/blob/master/inference_rules.adoc",
    "nvidia_aiperf": "https://docs.nvidia.com/aiperf/reference/ai-perf-metrics-reference",
    "google_sre": "https://sre.google/sre-book/monitoring-distributed-systems/",
